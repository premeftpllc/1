# PremeOS / Continue MCP credentials — TEMPLATE. Copy to .env.local and fill in.
#
# Put the filled-in .env.local in BOTH of these locations:
#   ~/.continue/.continue/.env.local            (shopify, zapier, calendar, drive)
#   <VS Code workspace>/.continue/.env.local    (slack, gmail, airtable)
# .env.local is gitignored. NEVER commit the filled-in file.

# --- Make.com -------------------------------------------------------------
# Only MAKE_MCP_AUTHORIZATION is actually read by mcp-make-bridge.js.
# The other two are inert but kept for reference.
MAKE_MCP_AUTHORIZATION=
MAKE_API_KEY=
MAKE_TEAM_ID=
MAKE_API_URL=https://us2.make.com/api/v2

# --- Notion ---------------------------------------------------------------
# Internal integration token, starts ntn_
NOTION_TOKEN=
NOTION_VERSION=2022-06-28

# --- Airtable -------------------------------------------------------------
# Personal Access Token, starts pat
AIRTABLE_TOKEN=

# --- Slack ----------------------------------------------------------------
# SLACK_USER_TOKEN (xoxp-) is preferred — bot scopes are easy to misconfigure.
# Scopes go under BOT Token Scopes vs USER Token Scopes; they look alike in the UI.
SLACK_USER_TOKEN=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# --- Shopify --------------------------------------------------------------
# MYSHOPIFY_DOMAIN is the correct name. SHOPIFY_SHOP_URL is wrong and ignored.
# Use EITHER the static admin token OR the client id/secret pair.
MYSHOPIFY_DOMAIN=premeftp.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Required scopes: read_products, write_products, read_customers,
# write_customers, read_orders, write_orders
# NOTE: the Admin API only returns the last 60 days of orders unless the app
# also holds read_all_orders (a separate Shopify approval).

# --- Google (Gmail / Calendar / Drive) ------------------------------------
# One OAuth 2.0 Client ID covers all three. NOT a service account —
# @klodr/gmail-mcp does not support service accounts at all.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar
GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive

# --- Zapier ---------------------------------------------------------------
# Use Zapier's "Other" generic-client connect option. Continue's built-in
# OAuth flow fails against Zapier ("Invalid authorization request").
ZAPIER_MCP_URL=

# --- misc -----------------------------------------------------------------
LOG_LEVEL=info
