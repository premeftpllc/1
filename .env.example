# This file is for repo scripts only; check which variables are used by scripts/ files.
# Continue MCP secrets go in ~/.continue/.env with the names listed in docs/CONTINUE-MCP-ARCHITECTURE.md.
# See also PC_SYNC_TASK_ENV_LOCAL.md for cross-machine secret transfer.

# Preme OS MCP Connector Configuration
# Copy this to .env.local and fill in actual values
# NEVER commit .env.local to git - add to .gitignore

# ===== OpenRouter (LLM Provider) =====
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# ===== Airtable (Inventory Management) =====
AIRTABLE_TOKEN=pat1.YOUR_PAT_HERE
# Get from: https://airtable.com/create/tokens
# Scopes needed: data.records:read, data.records:write, schema.bases:read

# ===== Make.com (Automation Platform) =====
MAKE_API_KEY=sk_live_YOUR_KEY_HERE
MAKE_TEAM_ID=YOUR_NUMERIC_TEAM_ID
MAKE_API_URL=https://us2.make.com/api/v2
# Get from: https://make.com/profile#api-access

# ===== Notion (Release Thesis Documentation) =====
NOTION_TOKEN=ntn_YOUR_TOKEN_HERE
NOTION_VERSION=2026-03-11
# Get from: https://www.notion.so/profile/integrations

# ===== Slack (Alert Channel) =====
SLACK_BOT_TOKEN=xoxb.YOUR_BOT_TOKEN_HERE
SLACK_TEAM_ID=YOUR_WORKSPACE_ID
# Get from: https://api.slack.com/apps
# Scopes: chat:write, channels:read, users:read

# ===== Google Cloud (Optional - Analytics) =====
GOOGLE_SERVICE_ACCOUNT_JSON=google-service-account.json
GOOGLE_API_KEY=AIzaSy_YOUR_KEY_HERE
# Get from: https://console.cloud.google.com/iam-admin/serviceaccounts
