mcpServers:
  - name: browser
    type: stdio
    command: npx.cmd
    args:
      - -y
      - "@playwright/mcp@latest"
    env: {}

  - name: web-search
    type: stdio
    command: node
    args:
      - C:/Users/Administrator/continue-demo/web-search-mcp/dist/index.js
    env:
      BROWSER_HEADLESS: "true"
      BROWSER_TYPES: chromium
      MAX_BROWSERS: "1"
      DEFAULT_TIMEOUT: "10000"
      MAX_CONTENT_LENGTH: "10000"

  - name: make-custom-mcp
    type: stdio
    command: node
    args:
      - C:/Users/Administrator/continue-demo/web-search-mcp/scripts/make-mcp-bridge.js

  - name: notion
    type: stdio
    command: node
    args:
      - C:/Users/Administrator/continue-demo/web-search-mcp/scripts/notion-mcp-launcher.js
