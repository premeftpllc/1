{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PremeOS: Set up this machine (npm + web-search build)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "setup"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PremeOS: Apply Continue config",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "config",
        "--apply"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PremeOS: Check local AI",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "health"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PremeOS: Test local chat",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "chat"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PremeOS: Test embeddings",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "embed"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PremeOS: Validate JSON",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "validate"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PremeOS: Check Continue MCP",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "mcp"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PremeOS: Enable ready MCP servers",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "mcp",
        "--apply"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PremeOS: Start LM Studio server",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "server"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "PremeOS: Load local model",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "load"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "PremeOS: Sync MCP secrets",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "secrets"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
