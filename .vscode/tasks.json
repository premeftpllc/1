{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PremeOS: Check local AI",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "health"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PremeOS: Test local chat",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "chat"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PremeOS: Test embeddings",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "embed"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PremeOS: Validate JSON",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "validate"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PremeOS: Check Continue MCP",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "mcp"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PremeOS: Enable ready MCP servers",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "mcp",
        "--apply"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PremeOS: Start LM Studio server",
      "type": "process",
      "command": "${env:HOME}/.lmstudio/bin/lms",
      "args": [
        "server",
        "start",
        "--port",
        "1235"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "PremeOS: Load local model (Nemotron 32K)",
      "type": "shell",
      "command": "\"$HOME/.lmstudio/bin/lms\" ps | grep -q nvidia/nemotron-3-nano-4b || \"$HOME/.lmstudio/bin/lms\" load nvidia/nemotron-3-nano-4b --context-length 32768 --parallel 1 --identifier nvidia/nemotron-3-nano-4b -y",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "PremeOS: Sync MCP secrets",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/scripts/workspace.py",
        "secrets"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
